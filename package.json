      "rollup@<3": "^2.80.0",
      "rollup@>=4 <5": "^4.59.0",
      "source-map-js": "^1.2.2",
      "ws@>=8 <9": "^8.21.0",
      "picomatch@<3": "^2.3.2",
      "prismjs": "^1.30.0",
      "fflate": "^0.8.3",
      "baseline-browser-mapping": "^2.11.0",
      "yaml@<2": "^1.10.3",
      "zod@>=4 <5": "^4.6.6",
      "@babel/core": "^7.29.6",
      "vite@>=8 <9": "^8.2.4"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "styled-components": "^6.3.6"
      },
      "ignoreMissing": [
        "react",
        "react-dom",
        "@babel/*",
        "@types/*",
        "@types/react",
        "@types/react-dom"
      ]
    }
  },
  "overrides": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "styled-components": "^6.3.6"
  },
  "resolutions": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
